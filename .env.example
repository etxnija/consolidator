# Copy this file to .env and fill in values before starting services.
# docker compose --env-file .env up

# PostgreSQL
POSTGRES_DB=consolidator
POSTGRES_USER=consolidator
POSTGRES_PASSWORD=changeme

# Service ports (host-side)
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Environment name — set to "production" to disable Swagger UI and ReDoc.
# Can also set DISABLE_DOCS=true for the same effect regardless of APP_ENV.
APP_ENV=development

# Add application-specific secrets below
# SECRET_KEY=changeme
